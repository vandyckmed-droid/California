{
  "name": "california-momentum-screen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Phone-first multi-horizon momentum screen with correlation grouping, sourced from Financial Modeling Prep.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "screen": "node src/run.ts",
    "stamp": "node scripts/stamp-version.mjs",
    "labs:etf-river": "node src/labs/etfRiver/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "serve": "npm run stamp && npx --yes serve web -l 5173",
    "verify:ui": "npm run stamp && node scripts/verify-ui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
